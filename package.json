{
  "name": "aurelius",
  "version": "0.1.0",
  "private": true,
  "description": "AURELIUS: 3D ring customization, e-commerce, and service management platform with an AI chatbot for Afable's Jewelry Store",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
