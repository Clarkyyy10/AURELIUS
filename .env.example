# AURELIUS — environment variables (Phase 2). Copy to .env.local and fill in. Never commit real values.

# "mock" = Phase 1 demo data in the browser (Demo Mode bar). "api" = real backend.
NEXT_PUBLIC_DATA_SOURCE=mock

# Public site address (used in email links)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (Project settings → API and → Database)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Pooled connection for the app (Supavisor, transaction mode, port 6543)
DATABASE_URL=postgresql://postgres.YOUR-PROJECT-REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1
# Direct connection for migrations (port 5432)
DIRECT_URL=postgresql://postgres.YOUR-PROJECT-REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# Test project only — the reset/seed scripts refuse to run unless DATABASE_URL contains this ref
SUPABASE_TEST_PROJECT_REF=

# Google Gemini (Google AI Studio → API keys). Server only.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Resend (email). Server only. EMAIL_FROM must use your verified domain.
RESEND_API_KEY=
EMAIL_FROM="Afable's Jewelry Store <no-reply@YOUR-DOMAIN>"

# Cloudflare Turnstile (login, registration, password reset)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# The store owner's email (gets the owner role when the seed script runs)
OWNER_EMAIL=

# Protects the scheduled email retry job (any long random string)
CRON_SECRET=
