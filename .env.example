# Copy to .env.local and fill in your own development values. Never commit real keys.

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Prisma (Supabase PostgreSQL connection strings)
DATABASE_URL=
DIRECT_URL=

# Google Gemini (server only)
GEMINI_API_KEY=

# Resend (server only)
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Cloudflare Turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
